# Edit User and the paths below if you don't use the pi user and /home/pi/teslatrack
[Unit]
Description=TeslaTrack car logbook and status
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/teslatrack
ExecStart=/usr/bin/python3 -u /home/pi/teslatrack/teslatrack.py
Restart=always
RestartSec=15
Nice=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
